{
  "name": "@shadcn-labs/devtools-toolbar",
  "version": "0.1.0",
  "description": "Dev-only in-browser toolbar for Shadcn Labs registries and project plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadcn-labs/devtools.git",
    "directory": "packages/toolbar"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "demo": "vite demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shadcn-labs/devtools-bridge": "workspace:*",
    "@shadcn-labs/devtools-core": "workspace:*",
    "@shadcn-labs/devtools-plugin-api": "workspace:*",
    "@shadcn-labs/devtools-plugin-ogimagecn": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "vite": "^8.3.0"
  }
}
